# Copia este archivo a .dev.vars (ignorado por git) y rellena los valores.
# .dev.vars lo lee `wrangler dev` para el desarrollo local de la API.
# NO pongas secretos reales en el repositorio.

# Client secret de Google OAuth (Google Cloud Console -> Credenciales).
GOOGLE_CLIENT_SECRET=""

# Opcional: si no se define, el Worker genera uno y lo guarda en D1.
SESSION_SECRET=""
